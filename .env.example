# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_USE_SSL=false

# RabbitMQ Queues and Routing Keys
RABBITMQ_EXCHANGE_NAME=messages.exchange
RABBITMQ_QUEUE_SMS_OUTBOUND=sms_outbound.queue
RABBITMQ_QUEUE_SMS_INBOUND=sms_inbound.queue
RABBITMQ_QUEUE_LEAD_RECEIVE=lead_receive.queue
RABBITMQ_ROUTING_KEY_SMS_OUTBOUND=sms_outbound_message
RABBITMQ_ROUTING_KEY_SMS_INBOUND=sms_inbound_message
RABBITMQ_ROUTING_KEY_LEAD_RECEIVE=lead_receive

# Email Provider (e.g., SendGrid, Mailgun, SES)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_API_URL=https://api.sendgrid.com/v3/mail/send
EMAIL_FROM=noreply@example.com

# SMS Provider (Telnyx)
SMS_PROVIDER=telnyx
TELNYX_API_KEY=your-telnyx-api-key
TELNYX_API_URL=https://api.telnyx.com/v2/messages
TELNYX_PUBLIC_KEY=your-telnyx-public-key

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret
