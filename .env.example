# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# RabbitMQ
RABBITMQ_HOST=b-d06a35cb-9232-47cc-a4e0-a2a7f0186fab.mq.us-east-1.on.aws
RABBITMQ_PORT=5671
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# Email Provider (e.g., SendGrid, Mailgun, SES)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@example.com

# SMS Provider (Telnyx)
SMS_PROVIDER=telnyx
TELNYX_API_KEY=your-telnyx-api-key
TELNYX_MESSAGING_PROFILE_ID=your-messaging-profile-id
TELNYX_PUBLIC_KEY=your-telnyx-public-key

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret